# Settings of the production database stack (deploy/db), on the VPS only. Copy to deploy/db/.env (git-ignored) and fill.
# POSTGRES_* must be the same as in the API's .env: the API connects with them.
POSTGRES_DB=bowspleef_ranked
POSTGRES_USER=bowspleef_ranked
POSTGRES_PASSWORD=changeme

# backup.sh / restore-check.sh (optional)
# Where the dumps go (default: $HOME/ranked/backups)
#BACKUP_DIR=/root/ranked/backups
# How many dumps without a label to keep (default: 21); dumps with a label are never deleted by the script
#KEEP=21
# Command that copies a dump away from the VPS; the dump path is "$1". Empty: no copy (KI-53).
#OFFSITE_COMMAND=rsync -a "$1" user@storage.example:backups/
